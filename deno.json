{
  "lock": true,
  "nodeModulesDir": "auto",
  "imports": {
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.1108.0",
    "@aws-sdk/lib-storage": "npm:@aws-sdk/lib-storage@3.1108.0",
    "@cloudamqp/amqp-client": "npm:@cloudamqp/amqp-client@4.0.0",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1.5.2",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/path": "jsr:@std/path@1.1.4",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "grammy": "npm:grammy@1.45.1",
    "hono": "npm:hono@4.13.14",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.6.7"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "include": ["apps", "packages", "tests", "tools", "deno.json", "drizzle.config.ts"],
    "exclude": ["coverage", "node_modules"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["coverage", "node_modules"]
  },
  "tasks": {
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check drizzle.config.ts apps/**/*.ts packages/**/*.ts tools/**/*.ts tests/**/*.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease --allow-net=127.0.0.1,localhost",
    "test:unit": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease tests/unit packages apps",
    "test:integration": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease --allow-net tests/integration",
    "test:e2e": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease --allow-net tests/e2e",
    "test:compose": "deno test --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease --allow-net tests/unit tests/integration tests/e2e",
    "coverage": "deno test --coverage=coverage --allow-env --allow-read --allow-write --allow-run --allow-sys=osRelease --allow-net && deno coverage coverage --lcov --output=coverage.lcov && deno run --allow-read tools/check_coverage.ts coverage.lcov 80",
    "licenses": "deno task db:kit --version && deno run --allow-read tools/check_licenses.ts",
    "scan:secrets": "deno run --allow-read tools/scan_secrets.ts",
    "audit": "deno audit --level=high && deno audit --lock=drizzle.lock --level=high",
    "db:kit": "deno run --lock=drizzle.lock --allow-all npm:drizzle-kit@0.31.10",
    "db:generate": "deno task db:kit generate --config=drizzle.config.ts",
    "db:check": "deno task db:kit check --config=drizzle.config.ts",
    "ci": "deno task fmt && deno task lint && deno task check && deno task db:check && deno task coverage && deno task licenses && deno task scan:secrets && deno task audit",
    "migrate": "deno run --allow-env --allow-read --allow-net tools/migrate.ts",
    "storage:init": "deno run --allow-env --allow-net --allow-sys=osRelease tools/init_storage.ts",
    "api": "deno run --allow-env --allow-net --allow-read --allow-sys=osRelease apps/api/main.ts",
    "worker": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run --allow-sys=osRelease apps/worker/main.ts",
    "telegram": "deno run --allow-env --allow-net --allow-read apps/telegram_bridge/main.ts",
    "maintenance": "deno run --allow-env --allow-net --allow-read --allow-sys=osRelease apps/maintenance/main.ts"
  },
  "test": {
    "exclude": ["tests/smoke"]
  }
}
