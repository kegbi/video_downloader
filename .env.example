# Modular Video Downloader example configuration
#
# Copy this file to .env and replace every `replace-me` or empty required value.
# `.env` is ignored by Git. Never commit live bot tokens, Telegram API credentials,
# numeric personal IDs, database passwords, RabbitMQ passwords, RustFS credentials,
# or internal API tokens.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_ENV=development
APP_LOG_LEVEL=info
APP_TIMEZONE=UTC

# Shared bearer token used by the Telegram bridge when calling the internal API.
# Generate a long random value for every deployment.
INTERNAL_API_TOKEN=replace-me-with-a-long-random-value

API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://api:8080

# -----------------------------------------------------------------------------
# PostgreSQL
# Keep these values aligned with the postgres service in Compose.
# -----------------------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=video_downloader
POSTGRES_USER=video_downloader
POSTGRES_PASSWORD=replace-me
POSTGRES_POOL_SIZE=10
POSTGRES_SSL_MODE=disable

# -----------------------------------------------------------------------------
# RabbitMQ
# RabbitMQ holds opaque job IDs; PostgreSQL remains the source of truth.
# -----------------------------------------------------------------------------

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=video_downloader
RABBITMQ_PASSWORD=replace-me
RABBITMQ_VHOST=video_downloader
RABBITMQ_TLS=false
RABBITMQ_DOWNLOAD_QUEUE=video.download
RABBITMQ_DOWNLOAD_RETRY_QUEUE=video.download.retry
RABBITMQ_DOWNLOAD_DEAD_LETTER_QUEUE=video.download.dead

# -----------------------------------------------------------------------------
# RustFS / S3-compatible artifact storage
# Keep RUSTFS_* credentials aligned with S3_ACCESS_KEY/S3_SECRET_KEY.
# Buckets must remain private.
# -----------------------------------------------------------------------------

RUSTFS_ACCESS_KEY=replace-me
RUSTFS_SECRET_KEY=replace-me
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_PORT=9000

S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=video-artifacts
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
S3_TEMP_PREFIX=temporary/
S3_ARTIFACT_PREFIX=artifacts/
# 0 disables the aggregate ready-artifact storage ceiling.
STORAGE_MAX_BYTES=0

# -----------------------------------------------------------------------------
# Telegram bridge
# TELEGRAM_BOT_TOKEN and at least one TELEGRAM_ADMIN_USER_IDS value are required
# only for a live Telegram run, not for automated development tests.
# Obtain the token from BotFather. Use stable numeric user IDs, comma-separated.
# -----------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_MODE=polling
TELEGRAM_BOT_API_ROOT=https://api.telegram.org
# Delivery ceiling for the selected Bot API path. Local-server deployments must
# keep this below 2000000000 and retain an explicit operational safety margin.
TELEGRAM_MAX_UPLOAD_BYTES=49000000
TELEGRAM_PROGRESS_MIN_INTERVAL_SECONDS=2
TELEGRAM_DELIVERY_LEASE_SECONDS=300
# Keep at least three heartbeat attempts inside one delivery lease.
TELEGRAM_DELIVERY_HEARTBEAT_SECONDS=30
TELEGRAM_DELIVERY_POLL_INTERVAL_MS=250
TELEGRAM_ACCESS_NOTIFICATION_LEASE_SECONDS=30
TELEGRAM_ACCESS_NOTIFICATION_POLL_INTERVAL_MS=1000
TELEGRAM_ACCESS_NOTIFICATION_MAX_ATTEMPTS=8
TELEGRAM_ADMIN_PROMPT_TTL_SECONDS=300
# Dokploy production only: keep the polling bridge stopped until the reviewed
# hosted-to-local Bot API cutover (if any); set it to 1 once the bot is on the local server.
TELEGRAM_BRIDGE_REPLICAS=0

# The official local Telegram Bot API is opt-in locally through compose.telegram-local.yaml and
# included in compose.dokploy.yaml. Obtain these production secrets from https://my.telegram.org;
# only the Bot API service receives them. Leave both empty when using the hosted or fake Bot API.
# There are deliberately no example/default credential values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# -----------------------------------------------------------------------------
# Authorization and request policy
# -----------------------------------------------------------------------------

ALLOW_PRIVATE_CHATS_ONLY=true
MAX_ACTIVE_JOBS_PER_USER=2
MAX_QUEUED_JOBS=100

# MVP accepts only public X status links. The implementation owns the exact URL
# parser; this list is an additional configuration boundary, not a regex input.
SOURCE_ALLOWED_HOSTS=x.com,www.x.com,twitter.com,www.twitter.com

# -----------------------------------------------------------------------------
# Downloader worker
# -----------------------------------------------------------------------------

WORKER_CONCURRENCY=2
WORKER_JOB_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_SOURCE_TIMEOUT_RETRY_DELAY_SECONDS=5
WORKER_RETRY_DELAY_SECONDS=30

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DOWNLOAD_TEMP_DIR=/var/tmp/video-downloader
DOWNLOAD_TIMEOUT_SECONDS=900
DOWNLOAD_MAX_DURATION_SECONDS=1800
DOWNLOAD_MAX_HEIGHT=1080
DOWNLOAD_FORMAT_SAFETY_BYTES=2000000
# The worker artifact ceiling must not exceed TELEGRAM_MAX_UPLOAD_BYTES.
MAX_ARTIFACT_BYTES=49000000
# Per-job media bytes allowed on the disk-backed worker volume. This must be at
# least (2 * MAX_ARTIFACT_BYTES) + DOWNLOAD_FORMAT_SAFETY_BYTES so split inputs
# and the merged output can coexist. Provision usable disk for at least
# WORKER_CONCURRENCY times this value, plus filesystem and operational headroom.
DOWNLOAD_MAX_TEMP_BYTES=200000000

# `live` invokes yt-dlp. Automated tests override this with `fixture` inside the
# test profile; production startup must reject fixture mode.
DOWNLOADER_MODE=live

# -----------------------------------------------------------------------------
# Retention and cleanup
# Valid modes: forever, ttl, after_delivery
# -----------------------------------------------------------------------------

RETENTION_DEFAULT_MODE=ttl
RETENTION_TTL_SECONDS=604800
RETENTION_AFTER_DELIVERY_GRACE_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=250
CLEANUP_INTERVAL_SECONDS=60
TEMP_OBJECT_MAX_AGE_SECONDS=86400

# Terminal job history, audit events, and published outbox records default to seven days.
# Set 0 only when an explicit indefinite metadata-retention policy is required.
JOB_HISTORY_TTL_SECONDS=604800
# Pending and resolved Telegram access requests are retained for seven days.
ACCESS_REQUEST_TTL_SECONDS=604800
ACCESS_REQUEST_DENIED_COOLDOWN_SECONDS=604800

# -----------------------------------------------------------------------------
# Optional observability
# -----------------------------------------------------------------------------

METRICS_ENABLED=true
METRICS_PATH=/metrics
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
LOKI_PORT=3100
PROMETHEUS_PORT=9090
